# ============================================================================
# TRUSTFORGE EXPRESS API — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and provide your deployment credentials.
# NEVER commit .env to version control.
# ============================================================================

# Service Port
PORT=8000

# Persistence Mode: 'supabase' (Cloud PostgreSQL) or 'local' (Durable Disk Store)
DATABASE_MODE=local

# Supabase Cloud PostgreSQL Configuration (Required if DATABASE_MODE=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM Provider Credentials
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
