# TrustForge Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
TRUSTFORGE_HOST=127.0.0.1
TRUSTFORGE_PORT=8000

# Comma-separated allowed CORS origins (include the Vite dev port)
TRUSTFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database (SQLite)
# ---------------------------------------------------------------------------
TRUSTFORGE_DB_PATH=./trustforge.db

# ---------------------------------------------------------------------------
# RAG — Embedding model
# ---------------------------------------------------------------------------
# sentence-transformers model (all-MiniLM-L6-v2 = 384-dim, CPU-capable, ~80 MB)
TRUSTFORGE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# RAG — FAISS vector index
# ---------------------------------------------------------------------------
TRUSTFORGE_KNOWLEDGE_INDEX_DIR=./knowledge/index
TRUSTFORGE_RETRIEVAL_TOP_K=5

# ---------------------------------------------------------------------------
# LLM provider — TIE (TrustForge Intelligent Evaluator)
# ---------------------------------------------------------------------------
# Supported values: groq | none
TRUSTFORGE_LLM_PROVIDER=groq

# Groq API key — obtain free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
TRUSTFORGE_LLM_MODEL=llama-3.1-8b-instant

# Temperature (0.0 = deterministic, 0.1 = slight variation for explanation quality)
TRUSTFORGE_LLM_TEMPERATURE=0.1

# Maximum tokens for TIE output
TRUSTFORGE_LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------
TRUSTFORGE_SCANNER_TIMEOUT=15
TRUSTFORGE_SCANNER_MAX_REDIRECTS=5
TRUSTFORGE_SCANNER_MAX_RESPONSE_BYTES=5242880

# ---------------------------------------------------------------------------
# Research / Evaluation
# ---------------------------------------------------------------------------
TRUSTFORGE_EVAL_RESULTS_DIR=./evaluation/results
TRUSTFORGE_RESEARCH_LOGGING=true
