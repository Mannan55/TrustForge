# TrustForge Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file.

# ────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ────────────────────────────────────────────────
# CORS — comma-separated allowed origins
# ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ────────────────────────────────────────────────
# SCORING VERSION
# Identifies which scoring config was used for a run.
# Update this whenever scoring_config.json changes.
# ────────────────────────────────────────────────
SCORING_VERSION=v1.0

# ────────────────────────────────────────────────
# RAG / EMBEDDINGS
# ────────────────────────────────────────────────
# Local sentence-transformers model name (free, runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Path to FAISS index on disk (created automatically on first run)
FAISS_INDEX_PATH=./data/vectors/dpdp_faiss.index
FAISS_METADATA_PATH=./data/vectors/dpdp_metadata.json

# ────────────────────────────────────────────────
# AI PROVIDER — optional, system runs without this
# Mode: "none" | "local" | "openai" | "groq"
# ────────────────────────────────────────────────
AI_PROVIDER=none

# Only required if AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Only required if AI_PROVIDER=groq  (free tier available)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama3-8b-8192

# ────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────
DATABASE_PATH=./data/trustforge.db

# ────────────────────────────────────────────────
# SCANNER SAFETY
# ────────────────────────────────────────────────
SCANNER_TIMEOUT_SECONDS=15
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=5000000
SCANNER_USER_AGENT=TrustForge-ComplianceScanner/1.0 (research; contact: admin@trustforge.example)

# ────────────────────────────────────────────────
# RESEARCH / EVALUATION
# ────────────────────────────────────────────────
EVALUATION_CASES_PATH=./evaluation/cases
RESEARCH_RESULTS_PATH=../research/results
